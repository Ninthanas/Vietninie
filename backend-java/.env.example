SPRING_PROFILES_ACTIVE=local
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
JWT_ISSUER=https://vietninie.local
JWT_AUDIENCE=vietninie-web
JWT_TTL_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ninthanas.github.io
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Set only for initial administrator bootstrap; omit after first start.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# PostgreSQL profile requires an existing database, Hibernate creates tables.
DB_URL=jdbc:postgresql://localhost:5432/vietninie
DB_USERNAME=vietninie
DB_PASSWORD=
DDL_AUTO=update
SEED_ENABLED=true
PORT=8080
